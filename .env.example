# Public site URL, without a trailing slash
APP_BASE_URL=Your-Info-Here

# Firebase / Firestore
FIREBASE_PROJECT_ID=Your-Info-Here
FIREBASE_SERVICE_ACCOUNT_JSON=Your-Info-Here

# eSewa merchant settings
ESEWA_PRODUCT_CODE=Your-Info-Here
ESEWA_SECRET=Your-Info-Here
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form

# Khalti ePayment v2
KHALTI_SECRET_KEY=Your-Info-Here
KHALTI_INITIATE_URL=https://a.khalti.com/api/v2/epayment/initiate/
KHALTI_LOOKUP_URL=https://a.khalti.com/api/v2/epayment/lookup/

# Fonepay merchant settings. Confirm the exact URL, fields, and signature
# template with Fonepay after merchant approval.
FONEPAY_PAYMENT_URL=Your-Info-Here
FONEPAY_MERCHANT_ID=Your-Info-Here
FONEPAY_SECRET_KEY=Your-Info-Here
FONEPAY_SIGNATURE_ALGORITHM=sha256
FONEPAY_SIGNATURE_TEMPLATE={{merchantId}}|{{orderId}}|{{amount}}|{{currency}}|{{returnUrl}}
FONEPAY_CALLBACK_SIGNATURE_TEMPLATE={{merchantId}}|{{orderId}}|{{amount}}|{{currency}}|{{status}}

